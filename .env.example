# .env.example

# GEMINI_API_KEY: Default Gemini AI API key (auto-injected in AI Studio)
GEMINI_API_KEY=""

# GROQ_API_KEY: Free Groq Cloud API key (e.g. gsk_...) for ultra-fast Llama-3/Gemma models
GROQ_API_KEY=""

# OPENROUTER_API_KEY: Free / low-cost OpenRouter API key (e.g. sk-or-...)
OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL=""
